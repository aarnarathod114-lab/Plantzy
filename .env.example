# Copy this file to `.env` and fill in the values you need.
# Nothing here is required to run Plantzy: without an API key the app still
# works, and the AI features report that they are unavailable.

# Google Gemini API key. Enables plant identification, the health check and
# the chat assistant. Keep it server-side only; it is never sent to the browser.
GEMINI_API_KEY=

# Gemini model used for all three AI features.
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated models tried in order if the one above is overloaded or rate limited.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash

# Port the server listens on.
PORT=3000

# Set to 1 when running behind a reverse proxy (Render, Fly, Cloud Run, nginx)
# so rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=0

# AI requests allowed per IP per minute.
AI_RATE_LIMIT_PER_MINUTE=20
